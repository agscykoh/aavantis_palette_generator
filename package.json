{
  "name": "aavantis-palette-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --win portable",
    "package:win": "npm run build && electron-builder --win portable",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64",
    "dev:web": "vite --host 127.0.0.1",
    "preview:web": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/lilita-one": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "typescript": "^5.7.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.aavanti.palette",
    "productName": "Aavanti's Palette Generator",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico",
      "signtoolOptions": {
        "publisherName": "Aavanti Gaitonde"
      }
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "electron/icon.png"
    },
    "portable": {
      "artifactName": "Aavanti-Palette-Generator-1.0.0-Windows.exe"
    }
  },
  "author": "Aavanti Gaitonde",
  "description": "A cute three-colour palette generator by Aavanti Gaitonde"
}
